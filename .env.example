# Copy to `.env` for local development. `.env` is gitignored — never commit a real key.
#
# Production equivalent: Cloudflare Pages -> Settings -> Environment variables
# (that is a secret store, so it never enters git history).

# Groq API key. Console: https://console.groq.com/keys
# Server-side ONLY. Do not prefix with PUBLIC_ — SvelteKit inlines unprefixed
# vars into the client bundle at build time, which would ship the key to
# every visitor. Call it through the /api/chat function instead.
GROQ_API_KEY=

# Optional: override the model used by the proxy.
#
# Model access is per-account, so verify what your key can actually call before
# relying on a name here. An unavailable model returns 404, not a clear error:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
#
# Good general choices:
#   qwen/qwen3.8-27b       non-reasoning, inexpensive — best default for a widget
#   openai/gpt-oss-120b    reasoning; spends max_tokens on a `reasoning` field, so
#                          raise max_tokens or `content` comes back empty
GROQ_MODEL=qwen/qwen3.8-27b